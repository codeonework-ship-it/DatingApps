<?xml version="1.0" encoding="utf-8"?>
<!-- Languages offered in Android's per-app language setting (API 33+).
     Must match AppLocalizations.supportedLocales / appLanguages in
     lib/core/i18n/app_locale_provider.dart. Maintained by hand, so
     androidResources.generateLocaleConfig must stay off (they conflict). -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en-US"/>
    <locale android:name="en-GB"/>
    <locale android:name="de"/>
    <locale android:name="fr"/>
    <locale android:name="ru"/>
    <locale android:name="es"/>
    <locale android:name="it"/>
    <locale android:name="pt"/>
    <locale android:name="nl"/>
    <locale android:name="pl"/>
</locale-config>
