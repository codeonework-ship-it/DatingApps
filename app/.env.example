# Local environment variables for Verified Dating App
# Copy to `.env.local`. The app connects only to the backend API; PostgreSQL
# credentials remain server-side and must never be bundled in Flutter.

APP_NAME=Connect
APP_THEME_MODE=dark
# API environment switch
# API_ENV=local|production (or prod)
API_ENV=local
API_LOCAL_BASE_URL=http://10.0.2.2:18080/v1
API_PROD_BASE_URL=http://72.61.242.87/v1
# Optional override; if set, this wins over API_ENV and the two URLs above.
# API_BASE_URL=http://10.0.2.2:18080/v1
API_TIMEOUT_MS=30000

# Push registration. Firebase client identifiers are project identifiers, not
# service-account secrets. Keep APNs .p8 and FCM service-account files on the
# backend only. Use apns on iOS only when the backend sends directly to APNs.
PUSH_TOKEN_PROVIDER=fcm
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_IOS_BUNDLE_ID=com.verifieddating.verifiedDatingApp

# Mock/runtime fallbacks
MOCK_USER_PREFIX=mock-user
MOCK_USER_ID=mock-user-001
# Backend mock credential login defaults (configure on the backend).
# MOCK_AUTH_USERNAME=qa_user
# MOCK_AUTH_PASSWORD=Password123!
MOCK_MATCHED_PROFILE_IDS=mock-female-001,mock-male-001
MOCK_FEMALE_USERS_COUNT=100
MOCK_MALE_USERS_COUNT=100
MOCK_MIN_AGE_YEARS=18
MOCK_MAX_AGE_YEARS=45
PLACEHOLDER_PROFILE_IMAGE_URL=https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80
PLACEHOLDER_AVATAR_IMAGE_URL=https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=500&q=80
