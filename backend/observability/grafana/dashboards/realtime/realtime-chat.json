          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, stream) (rate(verified_dating_realtime_delivery_lag_seconds_bucket[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          },
          "legendFormat": "p95 {{stream}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
