      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(verified_dating_realtime_connections_opened_total{service=\"mobile_bff\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          },
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
