    {
      "id": 18,
      "type": "logs",
      "title": "Realtime warnings (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "verified-dating-loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{unit=\"connect-mobile-bff.service\"} | json | msg=~\".*realtime.*\"",
          "datasource": {
            "type": "loki",
            "uid": "verified-dating-loki"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
