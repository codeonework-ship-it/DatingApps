      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route, status_class) (rate(verified_dating_http_requests_total{service=\"mobile_bff\",method=\"POST\",route=~\"/v1/chat/\\\\{matchID\\\\}/messages|/v1/social/channels/\\\\{channelID\\\\}/messages\"}[5m]))",
