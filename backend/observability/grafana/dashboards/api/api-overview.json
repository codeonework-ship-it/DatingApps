{
  "id": null,
  "uid": "connect-api-overview",
  "title": "Connect \u00b7 API overview (RED per route)",
  "description": "Rate, errors and duration per chi route template, SLO burn, saturation and build versions.",
  "tags": [
    "connect",
    "api",
    "slo"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "verified-dating-prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Restarts",
        "expr": "changes(process_start_time_seconds{job=~\"connect-.*\"}[2m]) > 0",
        "titleFormat": "{{component}} restarted",
        "step": "1m"
      }
    ]
  },
  "links": [
    {
      "title": "Connect dashboards",
      "type": "dashboards",
      "tags": [
        "connect"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "mobile_bff,api_gateway",
        "current": {
          "text": "mobile_bff",
          "value": "mobile_bff"
        },
        "multi": false,
        "includeAll": false,
        "options": [
          {
            "text": "mobile_bff",
            "value": "mobile_bff",
            "selected": true
          },
          {
            "text": "api_gateway",
            "value": "api_gateway",
            "selected": false
          }
        ]
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "verified-dating-prometheus"
        },
        "query": {
          "query": "label_values(verified_dating_http_requests_total{service=\"$service\"}, route)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(verified_dating_http_requests_total{service=\"$service\"}, route)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Golden signals",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(verified_dating_http_requests_total{service=\"$service\",route=~\"$route\",route!~\"/metrics|/healthz|/readyz|/debug/.*|/docs.*|/openapi.yaml\",status_class!=\"1xx\"}[5m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx ratio (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(verified_dating_http_requests_total{service=\"$service\",route=~\"$route\",route!~\"/metrics|/healthz|/readyz|/debug/.*|/docs.*|/openapi.yaml\",status_class=\"5xx\"}[5m])) / clamp_min(sum(rate(verified_dating_http_requests_total{service=\"$service\",route=~\"$route\",route!~\"/metrics|/healthz|/readyz|/debug/.*|/docs.*|/openapi.yaml\",status_class!=\"1xx\"}[5m])), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
