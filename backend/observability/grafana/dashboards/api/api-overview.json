    {
      "id": 6,
      "type": "stat",
      "title": "Availability error budget left (30d, approx.)",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - avg_over_time(verified_dating:http_service_error_ratio:rate1h{service=\"$service\"}[30d]) / 0.005",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          }
        }
      ],
      "description": "SLO: 99.5% of non-infrastructure requests without 5xx over 30 days. 100% = no budget used; negative = SLO missed.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "green",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
