  "panels": [
    {
      "id": 1,
      "title": "BFF request rate by status class",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status_class) (rate(verified_dating_http_requests_total{service=\"mobile_bff\"}[5m]))",
          "legendFormat": "{{status_class}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "BFF HTTP latency percentiles",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(verified_dating_http_request_duration_seconds_bucket{service=\"mobile_bff\",route!~\"/metrics|/healthz|/readyz|/debug/.*\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(verified_dating_http_request_duration_seconds_bucket{service=\"mobile_bff\",route!~\"/metrics|/healthz|/readyz|/debug/.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(verified_dating_http_request_duration_seconds_bucket{service=\"mobile_bff\",route!~\"/metrics|/healthz|/readyz|/debug/.*\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
