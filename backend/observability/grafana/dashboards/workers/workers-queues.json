{
  "id": null,
  "uid": "connect-workers-queues",
  "title": "Connect \u00b7 Workers & queues",
  "description": "Heartbeats of every BFF background worker, backlogs, outboxes and delivery SLOs.",
  "tags": [
    "connect",
    "workers",
    "queues"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "verified-dating-prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Restarts",
        "expr": "changes(process_start_time_seconds{job=~\"connect-.*\"}[2m]) > 0",
        "titleFormat": "{{component}} restarted",
        "step": "1m"
      }
    ]
  },
  "links": [
    {
      "title": "Connect dashboards",
      "type": "dashboards",
      "tags": [
        "connect"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "worker",
        "label": "Worker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "verified-dating-prometheus"
        },
        "query": {
          "query": "label_values(verified_dating_worker_runs_total, worker)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(verified_dating_worker_runs_total, worker)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "sort": 1,
        "regex": ""
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Heartbeats",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Heartbeat age \u00f7 stale threshold (1 = alert)",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "verified_dating:worker_heartbeat_age_seconds{worker=~\"$worker\"} / verified_dating:worker_stale_threshold_seconds{worker=~\"$worker\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          },
          "legendFormat": "{{worker}}",
          "instant": true
        }
      ],
      "description": "Age of the last successful run divided by max(3x interval, 5m).",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1.5,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.66
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Seconds since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "verified_dating:worker_heartbeat_age_seconds{worker=~\"$worker\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          },
          "legendFormat": "{{worker}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
