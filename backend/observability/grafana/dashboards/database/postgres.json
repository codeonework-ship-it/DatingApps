{
  "id": null,
  "uid": "connect-database",
  "title": "Connect \u00b7 PostgreSQL",
  "description": "postgres_exporter (connect_monitor role, pg_monitor) plus the application pool collectors.",
  "tags": [
    "connect",
    "database",
    "postgres"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "verified-dating-prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Restarts",
        "expr": "changes(process_start_time_seconds{job=~\"connect-.*\"}[2m]) > 0",
        "titleFormat": "{{component}} restarted",
        "step": "1m"
      }
    ]
  },
  "links": [
    {
      "title": "Connect dashboards",
      "type": "dashboards",
      "tags": [
        "connect"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datname",
        "label": "Database",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "verified-dating-prometheus"
        },
        "query": {
          "query": "label_values(pg_stat_database_xact_commit, datname)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(pg_stat_database_xact_commit, datname)",
        "refresh": 2,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "sort": 1,
        "regex": "/^(?!template|postgres$).*/"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PostgreSQL up",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pg_up)",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Connections used",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_activity_count) / max(pg_settings_max_connections)",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.6
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Database size",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_database_size_bytes{datname=\"$datname\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache hit ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(pg_stat_database_blks_hit{datname=\"$datname\"}[5m]) / clamp_min(rate(pg_stat_database_blks_hit{datname=\"$datname\"}[5m]) + rate(pg_stat_database_blks_read{datname=\"$datname\"}[5m]), 1e-9)",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Deadlocks (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(pg_stat_database_deadlocks{datname=\"$datname\"}[24h])",
          "datasource": {
            "type": "prometheus",
            "uid": "verified-dating-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Data disk free",
      "datasource": {
        "type": "prometheus",
        "uid": "verified-dating-prometheus"
