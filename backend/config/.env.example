# Shared
ENVIRONMENT=development
LOG_LEVEL=debug
API_PREFIX=/v1

# HTTP / gRPC addresses
API_GATEWAY_ADDR=:8080
MOBILE_BFF_ADDR=:8081
MOBILE_BFF_UPSTREAM_URL=http://localhost:8081
AUTH_SVC_GRPC_ADDR=:9091
PROFILE_SVC_GRPC_ADDR=:9092
MATCHING_SVC_GRPC_ADDR=:9093
CHAT_SVC_GRPC_ADDR=:9094
AUTH_SVC_ADMIN_ADDR=:10091
PROFILE_SVC_ADMIN_ADDR=:10092
MATCHING_SVC_ADMIN_ADDR=:10093
CHAT_SVC_ADMIN_ADDR=:10094

# Timeouts / rate limits
API_GATEWAY_READ_HEADER_TIMEOUT_SEC=10
MOBILE_BFF_READ_HEADER_TIMEOUT_SEC=10
SHUTDOWN_TIMEOUT_SEC=10
BFF_REQUEST_TIMEOUT_SEC=8
BFF_FAST_READ_TIMEOUT_MS=750
BFF_NORMAL_READ_TIMEOUT_MS=3000
BFF_WRITE_TIMEOUT_MS=8000
GATEWAY_READY_TIMEOUT_SEC=2
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW_SEC=1
GATEWAY_MAX_INFLIGHT=2000
GATEWAY_RETRY_AFTER_SEC=1
GATEWAY_SKIP_POSTGRES_PROBE=false
BFF_MAX_INFLIGHT=1500
BFF_RETRY_AFTER_SEC=1
BFF_BULKHEAD_AUTH_MAX_INFLIGHT=200
BFF_BULKHEAD_PROFILE_MAX_INFLIGHT=300
BFF_BULKHEAD_MATCHING_MAX_INFLIGHT=400
BFF_BULKHEAD_MESSAGING_MAX_INFLIGHT=300
BFF_BULKHEAD_ENGAGEMENT_MAX_INFLIGHT=300
BFF_BULKHEAD_ADMIN_MAX_INFLIGHT=80
IDEMPOTENCY_TTL_SECONDS=600
IDEMPOTENCY_LEASE_SECONDS=15
IDEMPOTENCY_POLL_MS=25
IDEMPOTENCY_MAX_RESPONSE_BYTES=1048576
AUTH_HTTP_TIMEOUT_SEC=12
SUPABASE_HTTP_TIMEOUT_SEC=15
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOCK_TIMEOUT_MS=1000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=15000
POSTGRES_POOL_MAX_CONNS=16
POSTGRES_POOL_MIN_CONNS=2

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_READ_REPLICA_URL=
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE=your_service_role_key

# Supabase Postgres connection pieces (optional but recommended)
# If SUPABASE_URL is omitted and SUPABASE_DB_HOST matches db.<project-ref>.supabase.co,
# runtime derives SUPABASE_URL as https://<project-ref>.supabase.co.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_db_password
SUPABASE_DB_SSLMODE=require
# Optional explicit DSN override (otherwise built from SUPABASE_DB_* values)
SUPABASE_DATABASE_URL=
DATABASE_URL=

# Supabase schema/table mapping
SUPABASE_USER_SCHEMA=public
SUPABASE_USERS_TABLE=users
SUPABASE_PREFERENCES_TABLE=preferences
SUPABASE_PHOTOS_TABLE=photos
SUPABASE_MATCHING_SCHEMA=public
SUPABASE_SWIPES_TABLE=swipes
SUPABASE_MATCHES_TABLE=matches
SUPABASE_MESSAGES_TABLE=messages
SUPABASE_ENGAGEMENT_SCHEMA=public
SUPABASE_UNLOCK_STATES_TABLE=match_unlock_states
SUPABASE_QUEST_TEMPLATES_TABLE=match_quest_templates
SUPABASE_QUEST_WORKFLOWS_TABLE=match_quest_workflows

# Chat realtime and workers
CHAT_WORKER_COUNT=8
CHAT_WORKER_QUEUE_SIZE=256
CHAT_REALTIME_SCHEMA=public
CHAT_REALTIME_TABLE=messages
CHAT_REALTIME_MAX_EVENTS=512
CHAT_REALTIME_LOG_LEVEL=warn
CHAT_REALTIME_HEARTBEAT_SEC=25
FANOUT_WORKER_COUNT=8
FANOUT_QUEUE_SIZE=4096
NOTIFICATION_WORKER_COUNT=2
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_POLL_INTERVAL_MS=500
NOTIFICATION_MAX_ATTEMPTS=5
# disabled keeps local in-app/WebSocket delivery only. Choose direct for native
# FCM HTTP v1 / APNs HTTP/2, or webhook for a managed provider bridge.
NOTIFICATION_PUSH_PROVIDER=disabled
NOTIFICATION_PUSH_WEBHOOK_URL=
NOTIFICATION_PUSH_WEBHOOK_TOKEN=
NOTIFICATION_FCM_PROJECT_ID=
# Path only; never commit the service-account JSON.
NOTIFICATION_FCM_CREDENTIALS_FILE=
# GOOGLE_APPLICATION_CREDENTIALS may be used instead of the preceding path.
NOTIFICATION_FCM_TOKEN_URL=https://oauth2.googleapis.com/token
NOTIFICATION_FCM_ENDPOINT=https://fcm.googleapis.com
NOTIFICATION_APNS_TEAM_ID=
NOTIFICATION_APNS_KEY_ID=
NOTIFICATION_APNS_BUNDLE_ID=com.verifieddating.verifiedDatingApp
# Path only; never commit the APNs .p8 private key.
NOTIFICATION_APNS_PRIVATE_KEY_FILE=
NOTIFICATION_APNS_USE_SANDBOX=true
# Leave empty to select Apple's sandbox/production endpoint automatically.
NOTIFICATION_APNS_ENDPOINT=
NOTIFICATION_SLO_MAX_QUEUE_DEPTH=1000
NOTIFICATION_SLO_MAX_OLDEST_AGE_SEC=30
NOTIFICATION_SLO_MIN_SUCCESS_PCT=99

# Emergency contact delivery. The webhook provider must accept a JSON request
# for each trusted contact and return 2xx only after the downstream message is
# durably accepted. Keep disabled outside an integrated environment; SOS alerts
# are still persisted and visible to operators.
SOS_DELIVERY_PROVIDER=disabled
SOS_DELIVERY_WEBHOOK_URL=
SOS_DELIVERY_WEBHOOK_TOKEN=
SOS_DELIVERY_POLL_INTERVAL_MS=500
SOS_DELIVERY_MAX_ATTEMPTS=8
MASTER_DATA_CACHE_TTL_SECONDS=300

# Fallback media URLs
DEFAULT_PROFILE_IMAGE_URL=https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=900&q=80
DEFAULT_AVATAR_IMAGE_URL=https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=500&q=80
MOCK_PHOTO_SEED_URL_TEMPLATE=https://picsum.photos/seed/%s/720/960
MOCK_BLOCKED_PHOTO_URL_TEMPLATE=https://picsum.photos/seed/%s/200/200
MEDIA_UPLOADS_DIR=.run/uploads/profile_photos
MEDIA_PUBLIC_BASE_URL=auto

# File storage backend (development defaults below).
# Production keeps media storage in its OWN file, loaded by systemd as a second
# EnvironmentFile (/etc/connect/storage.env) or via STORAGE_CONFIG_FILE:
#   config/storage.local.env.example  - Ubuntu VPS layout under /var/lib/connect/media
#   config/storage.s3.env.example     - AWS S3 bucket(s), encryption and auth modes
# Remove the storage lines from this file when you use one of those.
# Guide: documents/MEDIA_STORAGE_VPS_AND_S3_2026-10-01.md
#STORAGE_CONFIG_FILE=/etc/connect/storage.env
FILE_STORAGE_BACKEND=local_fs
USE_AWS_S3_STORAGE=false
AWS_S3_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_PROFILE_PHOTOS_PREFIX=profile-photos
AWS_S3_FORCE_PATH_STYLE=false

# Profile image moderation. Production/staging fail startup when required but
# no provider is configured. Rekognition inspects JPEG/PNG; WebP/HEIC enter the
# authenticated operator review queue instead of being silently approved.
MEDIA_MODERATION_PROVIDER=disabled
MEDIA_MODERATION_REQUIRED=false
MEDIA_MODERATION_MIN_CONFIDENCE=50
MEDIA_MODERATION_REVIEW_CONFIDENCE=70
MEDIA_MODERATION_REJECT_CONFIDENCE=90
MEDIA_MODERATION_REJECT_LABELS=Explicit Nudity,Violence,Visually Disturbing,Hate Symbols,Drugs & Tobacco
MEDIA_MODERATION_REVIEW_LABELS=Suggestive,Weapons,Alcohol,Gambling,Rude Gestures
AWS_REKOGNITION_ENDPOINT=

# Optional local username/password authentication and sample data.
MOCK_AUTH_ENABLED=true
MOCK_AUTH_USERNAME=qa_user
MOCK_AUTH_PASSWORD=Password123!
MOCK_DATA_ENABLED=true
MOCK_USER_ID=mock-user-001
MOCK_ACCESS_TOKEN=mock-access-token
MOCK_REFRESH_TOKEN=mock-refresh-token
MOCK_FEMALE_USERS_COUNT=100
MOCK_MALE_USERS_COUNT=100
MOCK_MIN_AGE_YEARS=18
MOCK_MAX_AGE_YEARS=45

# ── Card payments and auto-renewing subscriptions (PEN-01) ───────────────────
# stripe | sandbox | disabled. sandbox is an in-process provider for local
# development and QA: hosted card form, signed webhooks, renewal simulation,
# never a real charge. It is refused in stage/production.
PAYMENTS_PROVIDER=sandbox
# API base as the device sees it; used for checkout and return URLs.
PAYMENTS_PUBLIC_BASE_URL=http://10.0.2.2:18080/v1
PAYMENTS_CURRENCY=INR
PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_sandbox_local_only
# Stripe (required when PAYMENTS_PROVIDER=stripe). Point the Stripe webhook at
# POST {PAYMENTS_PUBLIC_BASE_URL}/billing/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
# Days a past_due subscription keeps its benefits while the card is retried.
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_RENEWAL_SWEEP_SECONDS=300
# Legacy provider-less activation (POST /billing/subscribe). Keep false.
# Browser/native live-call provider. public_jitsi is development-only.
CALL_TRANSPORT_PROVIDER=public_jitsi
CALL_ROOM_BASE_URL=
CALL_JWT_ISSUER=
CALL_JWT_AUDIENCE=
CALL_JWT_SECRET=
CALL_TOKEN_TTL_SECONDS=300

# Identity provider receives the validated ID and selfie as multipart content
# and returns approved, rejected, or manual_review.
IDENTITY_VERIFICATION_PROVIDER=disabled
# Defaults to true in production-like environments.
IDENTITY_VERIFICATION_REQUIRED=false
IDENTITY_VERIFICATION_WEBHOOK_URL=
IDENTITY_VERIFICATION_WEBHOOK_TOKEN=
# UUID of a disabled-login service account used only to attribute provider decisions.
IDENTITY_VERIFICATION_ACTOR_ID=

# Voice moderation runs before a recording can be sent or played.
VOICE_MODERATION_PROVIDER=disabled
# Defaults to true in production-like environments.
VOICE_MODERATION_REQUIRED=false
VOICE_MODERATION_WEBHOOK_URL=
VOICE_MODERATION_WEBHOOK_TOKEN=
PRIVATE_MEDIA_SIGNING_KEY=local-private-media-signing-key-change-me
PRIVATE_MEDIA_TOKEN_TTL_SECONDS=120
BILLING_LOCAL_ACTIVATION_ENABLED=false
# Per-plan likes_per_day / messages_per_day from the plan catalog, counted over the UTC day.
BILLING_ENFORCE_DAILY_LIMITS=true
