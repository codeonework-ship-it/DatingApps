# ─────────────────────────────────────────────────────────────────────────────
# Connect media storage — LOCAL FILESYSTEM (Ubuntu VPS)
#
# Install as /etc/connect/storage.env (root:connect, 0640). systemd loads it with
# its own EnvironmentFile= line (deploy/systemd/connect-mobile-bff.service);
# without systemd point STORAGE_CONFIG_FILE at it. Only MEDIA_*, AWS_S3_*,
# FILE_STORAGE_BACKEND and USE_AWS_S3_STORAGE are accepted in this file.
#
# Guide: documents/MEDIA_STORAGE_VPS_AND_S3_2026-10-01.md
# Directory setup: sudo deploy/scripts/setup_media_storage.sh
# Check:           sudo -u connect env ENVIRONMENT=production STORAGE_CONFIG_FILE=/etc/connect/storage.env /opt/connect/bin/mediactl check -probe
# ─────────────────────────────────────────────────────────────────────────────

FILE_STORAGE_BACKEND=local_fs
USE_AWS_S3_STORAGE=false

# Base directory (absolute path required in production/staging). Layout:
#   public/profile_photos  public/legacy_profile_photos  public/group_covers
#   private/chapter_photos private/theme_photos private/voice private/verification
#   quarantine/profile_photos   tmp/ (atomic uploads; same filesystem)
MEDIA_STORAGE_ROOT=/var/lib/connect/media
MEDIA_STORAGE_LAYOUT=kinds

# Uploads are refused (HTTP 507) when the filesystem has less free space.
MEDIA_MIN_FREE_MB=500

# public/ is group-readable so nginx (www-data, member of the connect group)
# can send authorized files. private/, quarantine/ and tmp/ are always 0700/0600.
MEDIA_PUBLIC_DIR_MODE=0750
MEDIA_PUBLIC_FILE_MODE=0640

# After the API authorizes a profile-photo request it hands the file to nginx's
# internal location (deploy/nginx/connect.conf). Leave empty to stream from Go.
MEDIA_LOCAL_ACCEL_REDIRECT_PREFIX=/_connect_media/

# Legacy flat upload directory from earlier releases. While set, files missing
# from MEDIA_STORAGE_ROOT are still read (and deleted) here. Copy it once with
#   mediactl copy -from legacy -legacy-dir <dir> -to local -apply
# then remove this line. Must not be inside MEDIA_STORAGE_ROOT.
#MEDIA_UPLOADS_DIR=/opt/connect/legacy/.run/uploads/profile_photos

# Base URL used in profile photo URLs returned by the API ("auto" = request host).
MEDIA_PUBLIC_BASE_URL=https://connect.example.com
