# Native local PostgreSQL mode. No Docker, Supabase API, PostgREST, phone, or
# email authentication is used by this configuration.
ENVIRONMENT=development
LOG_LEVEL=debug
USE_LOCAL_DB=true
# Port 55433, not 55432: another project holds 55432 on this machine and
# the application cluster was moved to avoid the collision. Override with
# LOCAL_POSTGRES_PORT if you relocate it again.
LOCAL_DATABASE_URL=postgresql://dating_app@127.0.0.1:55433/dating_app?sslmode=disable
MOCK_AUTH_ENABLED=false
MOCK_DATA_ENABLED=false
BFF_FAST_READ_TIMEOUT_MS=750
BFF_NORMAL_READ_TIMEOUT_MS=3000
BFF_WRITE_TIMEOUT_MS=8000
IDEMPOTENCY_TTL_SECONDS=600
IDEMPOTENCY_LEASE_SECONDS=15
IDEMPOTENCY_POLL_MS=25
IDEMPOTENCY_MAX_RESPONSE_BYTES=1048576
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOCK_TIMEOUT_MS=1000
POSTGRES_IDLE_TRANSACTION_TIMEOUT_MS=15000
POSTGRES_POOL_MAX_CONNS=16
POSTGRES_POOL_MIN_CONNS=2

API_GATEWAY_ADDR=:18080
MOBILE_BFF_ADDR=:18081
MOBILE_BFF_UPSTREAM_URL=http://127.0.0.1:18081
AUTH_SVC_GRPC_ADDR=127.0.0.1:19091
PROFILE_SVC_GRPC_ADDR=127.0.0.1:19092
MATCHING_SVC_GRPC_ADDR=127.0.0.1:19093
CHAT_SVC_GRPC_ADDR=127.0.0.1:19094
AUTH_SVC_ADMIN_ADDR=:19191
PROFILE_SVC_ADMIN_ADDR=:19192
MATCHING_SVC_ADMIN_ADDR=:19193
CHAT_SVC_ADMIN_ADDR=:19194

USER_SCHEMA=user_management
USERS_TABLE=users
PREFERENCES_TABLE=preferences
PHOTOS_TABLE=photos
MATCHING_SCHEMA=matching
FILE_STORAGE_BACKEND=local_fs
MEDIA_UPLOADS_DIR=.run/uploads/profile_photos
# Local development performs byte-signature, size, and dimension validation and
# records an approved local_validation decision without any external connection.
MEDIA_MODERATION_PROVIDER=disabled
MEDIA_MODERATION_REQUIRED=false
NOTIFICATION_WORKER_COUNT=2
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_POLL_INTERVAL_MS=500
NOTIFICATION_MAX_ATTEMPTS=5
# Leave blank for local inbox/WebSocket-only delivery. Configure a provider
# bridge here to fan out registered FCM/APNs tokens outside the app process.
NOTIFICATION_PUSH_WEBHOOK_URL=
NOTIFICATION_PUSH_WEBHOOK_TOKEN=

# ── Card payments and auto-renewing subscriptions (PEN-01) ───────────────────
# stripe | sandbox | disabled. sandbox is an in-process provider for local
# development and QA: hosted card form, signed webhooks, renewal simulation,
# never a real charge. It is refused in stage/production.
PAYMENTS_PROVIDER=sandbox
# API base as the device sees it; used for checkout and return URLs.
PAYMENTS_PUBLIC_BASE_URL=http://10.0.2.2:18080/v1
PAYMENTS_CURRENCY=INR
PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_sandbox_local_only
# Stripe (required when PAYMENTS_PROVIDER=stripe). Point the Stripe webhook at
# POST {PAYMENTS_PUBLIC_BASE_URL}/billing/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
# Days a past_due subscription keeps its benefits while the card is retried.
BILLING_PAST_DUE_GRACE_DAYS=7
BILLING_RENEWAL_SWEEP_SECONDS=300
# Legacy provider-less activation (POST /billing/subscribe). Keep false.
BILLING_LOCAL_ACTIVATION_ENABLED=false
# Per-plan likes_per_day / messages_per_day from the plan catalog, counted over the UTC day.
BILLING_ENFORCE_DAILY_LIMITS=true
# Wall reach tiers as likes:approved_comments:walls. Production defaults are
# 50:5:50,100:10:100; local development uses lower numbers so a few test members
# can try it.
BLOG_WALL_TIERS=3:1:50,5:2:100
