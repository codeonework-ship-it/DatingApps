# ─────────────────────────────────────────────────────────────────────────────
# Connect media storage — AWS S3 (or S3-compatible: MinIO, Wasabi, R2 ...)
#
# Install as /etc/connect/storage.env (root:connect, 0640 — it may hold keys;
# a world-readable file with secrets is refused). systemd loads it with its own
# EnvironmentFile= line; without systemd set STORAGE_CONFIG_FILE to its path.
# Only MEDIA_*, AWS_S3_*, FILE_STORAGE_BACKEND and USE_AWS_S3_STORAGE are
# accepted here. Values already in the process environment take precedence.
#
# Guide (IAM policies, bucket settings, switching from local):
#   documents/MEDIA_STORAGE_VPS_AND_S3_2026-10-01.md
# Check:  sudo -u connect env ENVIRONMENT=production STORAGE_CONFIG_FILE=/etc/connect/storage.env /opt/connect/bin/mediactl check -probe
# NEVER commit real keys. These are placeholders.
# ─────────────────────────────────────────────────────────────────────────────

FILE_STORAGE_BACKEND=aws_s3
USE_AWS_S3_STORAGE=true

# ── Buckets ─────────────────────────────────────────────────────────────────
AWS_S3_REGION=ap-south-1
# Private bucket: verification evidence, voice, chapter/theme photos,
# quarantined photos — and public kinds too when AWS_S3_PUBLIC_BUCKET is empty.
# Block Public Access ON, Object Ownership "bucket owner enforced" (no ACLs).
AWS_S3_BUCKET=connect-media-private-example
# Optional second bucket for public kinds (approved profile photos, group
# covers) so a CDN (CloudFront + Origin Access Control) can front it. It stays
# private too; the app never sets ACLs.
AWS_S3_PUBLIC_BUCKET=

# S3-compatible services only (leave empty for AWS):
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false

# ── Key layout ──────────────────────────────────────────────────────────────
# Optional global prefix (e.g. per environment when sharing a bucket).
AWS_S3_KEY_PREFIX=
# Per-kind prefixes (defaults shown; each kind must have its own prefix).
AWS_S3_PREFIX_PROFILE_PHOTOS=public/profile_photos
AWS_S3_PREFIX_LEGACY_PROFILE_PHOTOS=public/legacy_profile_photos
AWS_S3_PREFIX_GROUP_COVERS=public/group_covers
AWS_S3_PREFIX_PROFILE_PHOTOS_QUARANTINE=quarantine/profile_photos
AWS_S3_PREFIX_CHAPTER_PHOTOS=private/chapter_photos
AWS_S3_PREFIX_THEME_PHOTOS=private/theme_photos
AWS_S3_PREFIX_VOICE=private/voice
AWS_S3_PREFIX_VERIFICATION=private/verification
# Prefix that earlier releases embedded in stored keys; those rows are still
# read from AWS_S3_BUCKET verbatim. Keep the old value if you ever ran S3 mode.
AWS_S3_PROFILE_PHOTOS_PREFIX=profile-photos

# ── Encryption ──────────────────────────────────────────────────────────────
# AES256 (SSE-S3) or aws:kms (SSE-KMS). Empty = bucket default encryption.
AWS_S3_SSE=AES256
# For aws:kms: key id, key ARN or alias/... (empty = AWS managed aws/s3 key).
AWS_S3_SSE_KMS_KEY_ID=
# S3 Bucket Keys cut KMS request costs (default true with aws:kms).
AWS_S3_BUCKET_KEY_ENABLED=
# Send x-amz-checksum-sha256 so S3 verifies every upload. Set false only for
# S3-compatible services that reject it.
AWS_S3_SEND_CHECKSUMS=true

# ── Serving ─────────────────────────────────────────────────────────────────
# proxy:    the API authorizes and streams bytes (default; simplest, no CORS).
# redirect: the API authorizes, then 302s to a presigned GET (or to the CDN URL
#           below for public kinds). Private media (voice, chapters, themes,
#           evidence) is always streamed by the API.
AWS_S3_SERVE_MODE=proxy
AWS_S3_PRESIGN_TTL_SECONDS=300
# CDN in front of the public bucket (https), used only in redirect mode.
AWS_S3_PUBLIC_BASE_URL=

# ── Authentication — pick ONE mode ──────────────────────────────────────────
# static | profile | default_chain | assume_role
# (empty = inferred: role ARN -> assume_role, keys -> static,
#  AWS_S3_PROFILE -> profile, otherwise default_chain)
AWS_S3_AUTH_MODE=default_chain

# 1) static: dedicated IAM user access key (rotate every 90 days).
#AWS_S3_ACCESS_KEY_ID=AKIA................
#AWS_S3_SECRET_ACCESS_KEY=replace-me-never-commit
#AWS_S3_SESSION_TOKEN=

# 2) profile: shared credentials file readable by the connect user only
#    (ProtectHome=yes hides ~/.aws, so use /etc/connect/aws/...).
#AWS_S3_PROFILE=connect-media
#AWS_S3_SHARED_CREDENTIALS_FILE=/etc/connect/aws/credentials
#AWS_S3_SHARED_CONFIG_FILE=/etc/connect/aws/config

# 3) default_chain: EC2 instance profile (IAM role) via IMDSv2, ECS task role,
#    web identity, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in the environment.
#    Recommended on EC2. On a non-AWS VPS use static, profile or assume_role.

# 4) assume_role: STS AssumeRole into a media role. Source credentials come from
#    the static keys above, else AWS_S3_PROFILE, else the default chain.
#AWS_S3_ROLE_ARN=arn:aws:iam::111122223333:role/connect-media-writer
#AWS_S3_ROLE_EXTERNAL_ID=replace-with-agreed-external-id
#AWS_S3_ROLE_SESSION_NAME=connect-media
#AWS_S3_ROLE_DURATION_SECONDS=3600
