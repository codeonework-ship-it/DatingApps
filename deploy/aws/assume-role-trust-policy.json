{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectVpsAssumesMediaRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::111122223333:user/connect-vps-source"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "replace-with-agreed-external-id"
        }
      }
    }
  ]
}
