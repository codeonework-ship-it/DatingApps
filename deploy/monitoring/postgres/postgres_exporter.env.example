# /etc/connect-monitoring/postgres_exporter.env  (root:postgres_exporter 0640)
# Role created by deploy/monitoring/postgres/create_monitoring_role.sql.
# Use the loopback TCP listener; sslmode=disable is acceptable only on 127.0.0.1.
DATA_SOURCE_NAME=postgresql://connect_monitor:CHANGE_ME@127.0.0.1:5432/dating_app?sslmode=disable
