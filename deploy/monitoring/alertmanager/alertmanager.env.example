# /etc/connect-monitoring/alertmanager.env  (root:alertmanager 0640) - EXAMPLE VALUES ONLY.
# Rendered into /etc/connect-monitoring/alertmanager/alertmanager.yml by
# backend/observability/alertmanager/render_config.sh. Re-run
#   sudo deploy/monitoring/install_monitoring.sh --only alertmanager
# after editing.

# Required: generic webhooks for pages and tickets. Any PagerDuty/Opsgenie/
# Grafana OnCall/incident.io "Alertmanager webhook" integration URL works.
ALERTMANAGER_PAGE_WEBHOOK_URL=https://events.example-pager.com/integration/CHANGE_ME/alertmanager
ALERTMANAGER_TICKET_WEBHOOK_URL=https://tickets.example.com/hooks/CHANGE_ME

# Optional: PagerDuty Events API v2 integration key (pages only).
PAGERDUTY_ROUTING_KEY=

# Optional: Slack incoming webhook (pages and tickets).
SLACK_WEBHOOK_URL=
SLACK_PAGE_CHANNEL=#connect-pages
SLACK_TICKET_CHANNEL=#connect-alerts

# Optional: email for tickets (needs an SMTP relay with TLS).
ALERT_EMAIL_TO=
ALERT_SMTP_SMARTHOST=smtp.example.com:587
ALERT_SMTP_FROM=alerts@connect.example.com
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=

# Strongly recommended: dead man's switch receiving VerifiedDatingWatchdog
# every minute (healthchecks.io, Cronitor, Dead Man's Snitch, ...). It alerts
# you when Prometheus/Alertmanager or the whole VPS stops.
DEADMANS_SWITCH_URL=

# Prefix for the relative runbook_url annotations in notifications.
RUNBOOK_BASE_URL=https://github.com/CHANGE_ME/connect/blob/main
