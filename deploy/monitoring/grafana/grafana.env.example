# /etc/connect-monitoring/grafana.env  (root:grafana 0640) - loaded by the
# grafana-server drop-in (deploy/monitoring/grafana/grafana-server.override.conf).
# Grafana listens on loopback only; nginx publishes it under /grafana/ behind
# an IP allowlist + basic auth (deploy/nginx/snippets/connect-grafana.conf).
GF_SERVER_HTTP_ADDR=127.0.0.1
GF_SERVER_HTTP_PORT=3000
GF_SERVER_DOMAIN=connect.example.com
GF_SERVER_ROOT_URL=https://connect.example.com/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
GF_SECURITY_ADMIN_USER=connect-admin
# Generated by install_monitoring.sh on first install (root:grafana 0640).
GF_SECURITY_ADMIN_PASSWORD__FILE=/etc/connect-monitoring/grafana_admin_password
GF_SECURITY_COOKIE_SECURE=true
GF_SECURITY_COOKIE_SAMESITE=strict
GF_SECURITY_DISABLE_GRAVATAR=true
GF_SECURITY_CONTENT_SECURITY_POLICY=true
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_BASIC_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_SNAPSHOTS_EXTERNAL_ENABLED=false
GF_UNIFIED_ALERTING_ENABLED=false
GF_ALERTING_ENABLED=false
GF_METRICS_ENABLED=true
# Used by the provisioning files in /etc/grafana/provisioning/.
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
GRAFANA_DASHBOARDS_DIR=/var/lib/grafana/dashboards/connect
