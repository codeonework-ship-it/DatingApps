# Connect backend services without media access:
#   connect-backend@auth-svc  connect-backend@profile-svc  connect-backend@matching-svc
#   connect-backend@chat-svc  connect-backend@api-gateway
# The binary name is the instance name (/opt/connect/bin/%i).
# Install: sudo install -m 0644 deploy/systemd/connect-backend@.service /etc/systemd/system/
[Unit]
Description=Connect backend %i
Wants=network-online.target
After=network-online.target postgresql.service
PartOf=connect.target

[Service]
Type=simple
User=connect
Group=connect
WorkingDirectory=/opt/connect
EnvironmentFile=/etc/connect/connect.env
# Deliberately NOT loading /etc/connect/storage.env: S3 credentials stay scoped
# to connect-mobile-bff, and no media path is writable or even visible here.
ExecStart=/opt/connect/bin/%i
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0027

NoNewPrivileges=yes
ProtectSystem=strict
InaccessiblePaths=-/var/lib/connect/media
ReadOnlyPaths=/etc/connect
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=connect.target
